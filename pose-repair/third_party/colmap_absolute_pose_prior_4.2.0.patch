+class WeightedAbsolutePosePriorCostFunctor
+    : public AutoDiffCostFunctor<WeightedAbsolutePosePriorCostFunctor, 6, 7> {
+ public:
+  WeightedAbsolutePosePriorCostFunctor(const Rigid3d& sensor_from_world_prior,
+                                       const double rotation_sigma,
+                                       const double position_sigma)
+      : prior_(sensor_from_world_prior),
+        rotation_weight_(1.0 / rotation_sigma),
+        position_weight_(1.0 / position_sigma) {}
+
+  template <typename T>
+  bool operator()(const T* const sensor_from_world, T* residuals) const {
+    T unweighted[6];
+    prior_(sensor_from_world, unweighted);
+    for (int i = 0; i < 3; ++i) {
+      residuals[i] = T(rotation_weight_) * unweighted[i];
+      residuals[i + 3] = T(position_weight_) * unweighted[i + 3];
+    }
+    return true;
+  }
+
+ private:
+  AbsolutePosePriorCostFunctor prior_;
+  double rotation_weight_;
+  double position_weight_;
+};
+
+class AbsolutePosePriorBundleAdjuster : public CeresBundleAdjuster {
+ public:
+  AbsolutePosePriorBundleAdjuster(
+      const BundleAdjustmentOptions& options,
+      const CeresAbsolutePosePriorBundleAdjustmentOptions& prior_options,
+      const BundleAdjustmentConfig& config,
+      std::vector<AbsolutePosePrior> pose_priors,
+      Reconstruction& reconstruction)
+      : CeresBundleAdjuster(options, config),
+        prior_options_(prior_options),
+        pose_priors_(std::move(pose_priors)),
+        reconstruction_(reconstruction) {
+    THROW_CHECK(prior_options_.Check());
+    default_bundle_adjuster_ = std::make_unique<DefaultBundleAdjuster>(
+        options_, config_, reconstruction_);
+    size_t added = 0;
+    for (const auto& pose_prior : pose_priors_) {
+      if (!config_.HasImage(pose_prior.image_id)) {
+        continue;
+      }
+      Image& image = reconstruction_.Image(pose_prior.image_id);
+      THROW_CHECK(image.IsRefInFrame())
+          << "Full absolute pose priors require a reference sensor image";
+      Rigid3d& sensor_from_world = image.FramePtr()->RigFromWorld();
+      ceres::Problem& problem = *default_bundle_adjuster_->Problem();
+      const bool is_new_parameter_block =
+          !problem.HasParameterBlock(sensor_from_world.params.data());
+      problem.AddResidualBlock(
+          WeightedAbsolutePosePriorCostFunctor::Create(
+              pose_prior.sensor_from_world,
+              prior_options_.rotation_sigma,
+              prior_options_.position_sigma),
+          nullptr,
+          sensor_from_world.params.data());
+      if (is_new_parameter_block) {
+        SetManifold(&problem,
+                    sensor_from_world.params.data(),
+                    CreateProductManifold(CreateEigenQuaternionManifold(),
+                                          CreateEuclideanManifold<3>()));
+      }
+      ++added;
+    }
+    THROW_CHECK_GT(added, 0) << "No full pose priors were attached";
+    LOG(INFO) << "Added " << added << " full SE(3) pose priors";
+  }
+
+  std::shared_ptr<BundleAdjustmentSummary> Solve() override {
+    std::shared_ptr<ceres::Problem> problem = default_bundle_adjuster_->Problem();
+    ceres::Solver::Summary ceres_summary =
+        SolveWithGpuFallback(options_, config_, problem.get());
+    if (options_.print_summary || VLOG_IS_ON(1)) {
+      PrintSolverSummary(ceres_summary,
+                         "Absolute pose prior bundle adjustment report");
+    }
+    return CreateSummaryAndLogFailure(std::move(ceres_summary),
+                                      "Absolute pose prior bundle adjustment");
+  }
+
+  std::shared_ptr<ceres::Problem>& Problem() override {
+    return default_bundle_adjuster_->Problem();
+  }
+
+ private:
+  CeresAbsolutePosePriorBundleAdjustmentOptions prior_options_;
+  std::vector<AbsolutePosePrior> pose_priors_;
+  Reconstruction& reconstruction_;
+  std::unique_ptr<DefaultBundleAdjuster> default_bundle_adjuster_;
+};
+
