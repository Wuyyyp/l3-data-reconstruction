+int RunAbsolutePosePriorBundleAdjuster(int argc, char** argv) {
+  std::filesystem::path input_path;
+  std::filesystem::path output_path;
+  std::filesystem::path pose_csv;
+  double position_prior_sigma_m = 0.1;
+  double rotation_prior_sigma_deg = 0.5;
+
+  OptionManager options;
+  options.AddRequiredOption("input_path", &input_path);
+  options.AddRequiredOption("output_path", &output_path);
+  options.AddRequiredOption("pose_csv", &pose_csv);
+  options.AddDefaultOption("position_prior_sigma_m", &position_prior_sigma_m);
+  options.AddDefaultOption("rotation_prior_sigma_deg", &rotation_prior_sigma_deg);
+  options.AddBundleAdjustmentOptions();
+  if (!options.Parse(argc, argv)) {
+    return EXIT_FAILURE;
+  }
+  if (!ExistsDir(input_path) || !ExistsDir(output_path)) {
+    LOG(ERROR) << "`input_path` and `output_path` must be directories";
+    return EXIT_FAILURE;
+  }
+  if (!ExistsFile(pose_csv)) {
+    LOG(ERROR) << "`pose_csv` does not exist";
+    return EXIT_FAILURE;
+  }
+
+  auto split_csv = [](const std::string& line) {
+    std::vector<std::string> fields;
+    std::stringstream stream(line);
+    std::string field;
+    while (std::getline(stream, field, ',')) {
+      fields.push_back(field);
+    }
+    return fields;
+  };
+  std::ifstream stream(pose_csv);
+  std::string line;
+  if (!std::getline(stream, line)) {
+    LOG(ERROR) << "Pose CSV has no header: " << pose_csv;
+    return EXIT_FAILURE;
+  }
+  const std::vector<std::string> header = split_csv(line);
+  std::unordered_map<std::string, size_t> column;
+  for (size_t index = 0; index < header.size(); ++index) {
+    column.emplace(header[index], index);
+  }
+  const auto require_column = [&column](const std::string& name) {
+    const auto it = column.find(name);
+    THROW_CHECK(it != column.end()) << "Pose CSV is missing column: " << name;
+    return it->second;
+  };
+  const size_t camera_column = require_column("camera");
+  const size_t filename_column = require_column("image_filename");
+  std::array<size_t, 12> matrix_columns;
+  for (int row = 0; row < 3; ++row) {
+    for (int col = 0; col < 4; ++col) {
+      matrix_columns[4 * row + col] =
+          require_column("T_cw_" + std::to_string(row) + std::to_string(col));
+    }
+  }
+  std::unordered_map<std::string, Rigid3d> priors_by_name;
+  while (std::getline(stream, line)) {
+    const std::vector<std::string> fields = split_csv(line);
+    if (fields.size() != header.size()) {
+      LOG(WARNING) << "Skipping malformed pose CSV row";
+      continue;
+    }
+    Eigen::Matrix3d rotation;
+    Eigen::Vector3d translation;
+    for (int row = 0; row < 3; ++row) {
+      for (int col = 0; col < 3; ++col) {
+        rotation(row, col) = std::stod(fields[matrix_columns[4 * row + col]]);
+      }
+      translation(row) = std::stod(fields[matrix_columns[4 * row + 3]]);
+    }
+    const std::string name = fields[camera_column] + "/" + fields[filename_column];
+    priors_by_name.emplace(
+        name, Inverse(Rigid3d(Eigen::Quaterniond(rotation), translation)));
+  }
+
+  Reconstruction reconstruction;
+  reconstruction.Read(input_path);
+  ObservationManager(reconstruction).FilterObservationsWithNegativeDepth();
+  BundleAdjustmentConfig config;
+  std::vector<AbsolutePosePrior> priors;
+  for (const image_t image_id : reconstruction.RegImageIds()) {
+    const Image& image = reconstruction.Image(image_id);
+    config.AddImage(image_id);
+    config.SetConstantCamIntrinsics(image.CameraId());
+    config.SetConstantSensorFromRigPose(image.CameraPtr()->SensorId());
+    const auto prior_it = priors_by_name.find(image.Name());
+    if (prior_it == priors_by_name.end()) {
+      LOG(ERROR) << "No pose prior for registered image: " << image.Name();
+      return EXIT_FAILURE;
+    }
+    priors.push_back({image_id, prior_it->second});
+  }
+  if (priors.empty()) {
+    LOG(ERROR) << "Input reconstruction has no registered images";
+    return EXIT_FAILURE;
+  }
+  BundleAdjustmentOptions ba_options = *options.bundle_adjustment;
+  ba_options.refine_focal_length = false;
+  ba_options.refine_principal_point = false;
+  ba_options.refine_extra_params = false;
+  ba_options.refine_sensor_from_rig = false;
+  CeresAbsolutePosePriorBundleAdjustmentOptions prior_options;
+  prior_options.position_sigma = position_prior_sigma_m;
+  prior_options.rotation_sigma = rotation_prior_sigma_deg * M_PI / 180.0;
+  auto adjuster = CreateAbsolutePosePriorCeresBundleAdjuster(
+      ba_options, prior_options, config, std::move(priors), reconstruction);
+  const auto summary = adjuster->Solve();
+  if (!summary->IsSolutionUsable()) {
+    LOG(ERROR) << summary->BriefReport();
+    return EXIT_FAILURE;
+  }
+  reconstruction.UpdatePoint3DErrors();
+  reconstruction.Write(output_path);
+  return EXIT_SUCCESS;
+}
